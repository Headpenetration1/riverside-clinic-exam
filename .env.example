# Copy to .env and fill in real values. .env is git-ignored.
FLASK_CONFIG=development

# Generate each secret with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
JWT_SECRET=change-me

# 32 random bytes, base64 encoded:  python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
FILE_ENCRYPTION_KEY=change-me

# Chatbot (https://cloud.cerebras.ai). Leave empty to disable the assistant.
CEREBRAS_API_KEY=
# Public production model as of 2026-09; verify the official catalog before overriding.
CEREBRAS_MODEL=gpt-oss-120b

# Optional: defaults to a SQLite file in ./instance
# DATABASE_URL=postgresql://user:pass@localhost/clinic

# Outgoing mail for password-reset links. Leave SMTP_HOST empty in development:
# the message (link included) is then written to the server log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=noreply@riverside-clinic.example

# Public origin of the portal, used in emailed links. Production requires an
# explicit HTTPS origin; reset links never use the request Host header.
PUBLIC_BASE_URL=
